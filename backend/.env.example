# Core app settings
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/rental-db
JWT_SECRET=

# Optional secure bootstrap for the initial platform admin account. Never expose these in public registration.
ADMIN_NAME="Platform Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=

# Image upload settings
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment provider configuration
# Use exactly one provider and keep the rest unset.
PAYMENT_PROVIDER=chapa
# This example intentionally uses sandbox mode. Chapa Test Mode simulates transfers;
# it cannot confirm that money reached a real bank account.
PAYMENT_MODE=sandbox
PAYMENT_SANDBOX=true

# Sandbox payouts are submitted only when Chapa has supplied a test destination
# account and it is configured below. A blank value means payouts will not be submitted.
# The landlord's saved bank account is never sent to Chapa in sandbox mode.
CHAPA_TRANSFER_TEST_ACCOUNT_NUMBER=
# Optional sandbox simulation outcome: success, failed, or pending. This only controls
# the simulation; it is not proof of a real transfer or a substitute for verification.
CHAPA_TRANSFER_TEST_STATUS=success

# Live payouts are real bank transfers. Do not switch to live until live Chapa
# credentials, a supported destination, and the required approval/OTP settings are ready.
# For live payouts set PAYMENT_MODE=live and PAYMENT_SANDBOX=false, use the live
# CHAPA_SECRET_KEY issued by Chapa, and configure server approval below and in Chapa.
# Configure this backend-only secret in the Chapa Dashboard's server-approval
# settings and register https://<backend-host>/api/chapa/transfer-approval.
CHAPA_TRANSFER_APPROVAL_SECRET=
CHAPA_API_KEY=your_chapa_sandbox_api_key
CHAPA_SECRET_KEY=your_chapa_sandbox_secret_key
# In production, configure this on the backend host (for example, Render Environment),
# not in frontend environment variables or committed files.
CHAPA_BASE_URL=https://api.chapa.co
CHAPA_WEBHOOK_SECRET=your_webhook_secret
CHAPA_CALLBACK_URL=http://localhost:5000/api/payments/callback/chapa
CHAPA_RETURN_URL=http://localhost:3001/tenant/rent-payment
# Optional dedicated encryption key for landlord bank account numbers.
# If unset, the backend derives a separate encryption key from JWT_SECRET.
# Keep either key stable; changing it makes previously encrypted account numbers unreadable.
BANK_ACCOUNT_ENCRYPTION_KEY=

# Optional generic app URLs
APP_BASE_URL=http://localhost:3001
BACKEND_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
EMAIL_USER=
EMAIL_PASS=

# Alternative provider template (leave unused unless configured)
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_SUCCESS_URL=http://localhost:3001/tenant/rent-payment
# STRIPE_CANCEL_URL=http://localhost:3001/tenant/rent-payment
